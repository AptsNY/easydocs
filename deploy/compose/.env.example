POSTGRES_USER=easydocs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=easydocs
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=easydocs;Username=easydocs;Password=change-me
BLOB_ROOT=/data/blobs
# Deliberately too short to boot. The app fails fast under 32 bytes, and that refusal is the point:
# the previous placeholder was 51 bytes, so `cp .env.example .env && docker compose up` — the exact
# quickstart this file ships with — came up healthy and signed real sessions with a secret published
# in a public repository. Anyone could forge an ed_session for any install that took it literally.
# Generate one with:  openssl rand -base64 48
Jwt__Secret=CHANGE_ME
PUBLIC_BASE_URL=http://localhost:8080
WOPI_HOST_URL=http://easydocs:8080
COLLABORA_URL=http://collabora:9980
# true only when an edge proxy terminates TLS in front of Collabora (i.e. PUBLIC_BASE_URL is https).
# It decides whether the editor page opens ws:// or wss:// back to coolwsd, so a mismatch means the
# editor loads its chrome and then hangs with no document.
COLLABORA_SSL_TERMINATION=false

# Rate limits (spec §11) — uncomment to override. Defaults live in Common/RateLimits.cs and are per
# client address, so if a reverse proxy fronts this app they apply to the PROXY unless you also set
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true. Raise AnonDownload if a whole team opens one share link;
# tighten Auth if this install is public — its default is a flood brake, not an anti-stuffing control.
# RateLimit__AnonShare__PermitLimit=120     # GET /s/{token},          per 60s
# RateLimit__AnonDownload__PermitLimit=30   # GET /s/{token}/download, per 60s
# RateLimit__TokenMint__PermitLimit=20      # POST /api/v1/tokens,     per 60s, per user
# RateLimit__Auth__BurstLimit=1000          # login and register meter separately: 1000 burst,
# RateLimit__Auth__TokensPerPeriod=50       #   refilling 50 every 10s => 300/min sustained
# RateLimit__Auth__ReplenishmentSeconds=10
